<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Modern .NET, deliberately: this is the WCF *client* side (consuming
    the duplex NetTcp contract), which System.ServiceModel.NetTcp fully
    supports on current .NET — it's only duplex *hosting* on modern .NET
    (via CoreWCF) that isn't reliable yet. See the TelephonyBridge
    project's csproj comment and this repo's README.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lakbay.AgentDesktop.TelephonyBridge.Simulator</RootNamespace>
    <AssemblyName>Lakbay.AgentDesktop.TelephonyBridge.Simulator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
    <!-- No explicit System.Security.Cryptography.Xml override needed here (unlike the
         net48 TelephonyBridge library) - .NET 10's shared framework already provides a
         patched version automatically; NuGet's package-pruning would just remove an
         explicit reference to it anyway (NU1510). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lakbay.AgentDesktop.TelephonyBridge\Lakbay.AgentDesktop.TelephonyBridge.csproj" />
  </ItemGroup>

</Project>
